[Unit]
Description=Apollo Supply Docker Compose Stack
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s
WorkingDirectory=%INSTALL_DIR%
# Use standard docker compose commands. 
# Ensure full path to docker is used (usually /usr/bin/docker)
ExecStart=%INSTALL_DIR%/scripts/systemd/restore.sh
ExecStop=/usr/bin/docker stop sabnzbd qbittorrent gluetun

[Install]
WantedBy=multi-user.target
