[Unit]
Description=Apollo Supply Docker Compose Stack
Requires=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/batmon/apollo-supply
# Use standard docker compose commands. 
# Ensure full path to docker is used (usually /usr/bin/docker)
ExecStart=/home/batmon/apollo-supply/restore.sh
ExecStop=/usr/bin/docker stop sabnzbd qbittorrent gluetun

[Install]
WantedBy=multi-user.target
