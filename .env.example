
# Gluetun VPN Settings
# See https://github.com/qdm12/gluetun/wiki
VPN_SERVICE_PROVIDER=custom
VPN_USER=
VPN_PASSWORD=
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=

# Inbound ports permitted through the tunnel, comma-separated.
# Holds the qBittorrent port. slskd's listen port (below) is appended by
# docker-compose.yml, so the firewall rule cannot drift from the real port.
# FIREWALL_VPN_INPUT_PORTS=51820

# slskd's inbound peer port. Reserve one in the AirVPN client area first: any
# free port >= 2048 (5 per account). AirVPN opens each forwarded port on every
# server and hands a given port number to a single account, so slskd's default
# 50300 is usually already taken by someone else.
SLSKD_LISTEN_PORT=

# Gluetun control server, read by slskd to confirm the tunnel is up.
# Generate with: openssl rand -hex 24
GLUETUN_CONTROL_API_KEY=

# slskd web UI credentials (http://muspelheim:5030)
SLSKD_USERNAME=
SLSKD_PASSWORD=

# Soulseek network account
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
